# Скопируйте в .env и заполните. Реальный .env в git не попадает.
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Число доверенных прокси перед приложением (0 — если смотрит в интернет напрямую).
# От него зависит, какой IP берётся из X-Forwarded-For для rate limiting.
NUM_PROXIES=1

DATABASE_URL=postgres://myspotify:myspotify@db:5432/myspotify
POSTGRES_PASSWORD=myspotify

REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_QUEUE_URL=redis://redis-queue:6379/0

# Прод: список origin'ов веб-клиента через запятую (в dev разрешены все)
CORS_ALLOWED_ORIGINS=
# Базовый URL веб-клиента — из него собираются ссылки в письмах
FRONTEND_URL=http://localhost:3000

# Почта (в dev письма печатаются в консоль)
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Общий стенд: compose.shared.yml -------------------------------------
# Базы, которые создаются при ПЕРВОЙ инициализации Postgres — по одной на
# разработчика. Позже список не перечитывается, новую базу заводите так:
#   docker compose -f compose.shared.yml exec db createdb -U myspotify <имя>
DEV_DATABASES=myspotify_loke,myspotify_dev2

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Когда app-стек смотрит в стенд, а не в свой локальный db, DATABASE_URL берёт
# адрес стенда и ИМЯ СВОЕЙ базы из DEV_DATABASES. На самой машине стенда:
#   DATABASE_URL=postgres://myspotify:myspotify@127.0.0.1:5432/myspotify_loke
# Именно 127.0.0.1, а не localhost: если Docker живёт в WSL, его релей слушает
# только IPv4, а localhost резолвится сначала в ::1 — и соединение отваливается.
# У коллеги — тот же URL, но с IP стенда и своим именем базы.
